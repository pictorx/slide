# Demo profile: no Honeycoin account needed.
# cp .env.demo .env && bun run dev

OFFRAMP_PROVIDER=mock
FX_PROVIDER=open-er-api

# Base Sepolia. Mock mode refuses to start on Base mainnet.
X402_NETWORK=eip155:84532
PORT=4000
DB_PATH=demo.sqlite

FACILITATOR_URL=https://facilitator.payai.network

# Everything below has a working default in mock mode. Uncomment to override.

# Fee wallet defaults to index 0 of the demo mnemonic:
#   0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
# FEE_WALLET_ADDRESS=0x...

# Anvil's public test mnemonic. Deposit addresses come from index 1 upward.
# Replace it with your own if you want to sweep the testnet USDC back out.
# MOCK_MNEMONIC="test test test test test test test test test test test junk"

# "success" | "fail" | "random". Use fail to exercise the refund and
# reconciliation path end to end.
MOCK_OUTCOME=success
MOCK_PAYOUT_DELAY_MS=4000
MOCK_REFUND_DELAY_MS=4000

# The mock signs its own webhooks with this and posts them to your own endpoint.
HONEYCOIN_WEBHOOK_SECRET=demo-webhook-secret

# Offline fallback if open.er-api.com is unreachable: set FX_PROVIDER=static.
FX_STATIC_KES_PER_USDC=129
