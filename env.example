# Base Sepolia while testing, eip155:8453 for Base mainnet.
X402_NETWORK=eip155:84532
PORT=4000
DB_PATH=offramp.sqlite

FACILITATOR_URL=https://facilitator.payai.network

# Collects tier fees only. Never holds payout funds.
FEE_WALLET_ADDRESS=0x...

# --- Honeycoin (Dashboard > Developers > API Keys) ---
HONEYCOIN_API_KEY=HC_...
HONEYCOIN_PUBLIC_KEY=...
HONEYCOIN_WEBHOOK_SECRET=...
HONEYCOIN_AUTH_URL=https://api-v2.honeycoin.app/api/b2b
HONEYCOIN_CRYPTO_URL=https://crypto.honeycoin.app/api
HONEYCOIN_TIMEOUT_MS=8000

# --- FX rate for the fee tiers (Honeycoin FX Hub) ---
# GET /api/b2b/fx/rate?from=USDC&to=KES
FX_FROM=USDC
FX_TO=KES

# Either orientation is accepted. A value is rejected unless it, or its
# reciprocal, lands in this band. This is what catches an inverted response.
FX_RATE_SANITY_MIN=60
FX_RATE_SANITY_MAX=400

# How long one request body keeps its quoted rate. Must exceed the gap between
# the 402 challenge and the client's paid retry.
RATE_LOCK_TTL_MS=900000

# Optional. Leave unset to fail closed when FX Hub is unreachable. If set, it
# is used only as a fallback and logged as an error every time.
# FALLBACK_KES_PER_USDC=129
